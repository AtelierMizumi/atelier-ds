{
  "$description": "Atelier design tokens. Source of truth for every Atelier site. Edit here, then run `npm run build`.",
  "version": "0.1.0",
  "core": {
    "color": {
      "void": "#030A2A",
      "navy": "#061A6E",
      "deep": "#0A2BB0",
      "sea": "#1D7BFF",
      "cyan": "#62E6FF",
      "mist": "#CFE4FF",
      "muted": "#9DB8DB",
      "paper": "#F7FBFF",
      "ink": "#05060F",
      "warm": "#FF2D2D",
      "pink": "#FF7AD0",
      "good": "#5FF2C4",
      "warn": "#FFD65A",
      "bad": "#FF5F87",
      "water-mid": "#0B4DE0",
      "water-bright": "#1A8CFF"
    },
    "font": {
      "display": "\"Barlow Condensed\", \"Arial Narrow\", Impact, sans-serif",
      "body": "\"Be Vietnam Pro\", system-ui, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, monospace"
    },
    "size": {
      "display-xl": "clamp(120px, 22vh, 230px)",
      "display-l": "clamp(44px, 8.4vh, 96px)",
      "display-m": "clamp(40px, 5vw, 68px)",
      "h1": "clamp(40px, 6vw, 80px)",
      "h2": "clamp(28px, 3.6vw, 44px)",
      "h3": "clamp(21px, 2.2vw, 26px)",
      "title": "clamp(26px, 4.6vh, 46px)",
      "lede": "clamp(19px, 1.6vw, 21px)",
      "body": "clamp(16px, 1.1vw, 18px)",
      "small": "15px",
      "meta": "13px"
    },
    "space": {
      "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px",
      "6": "32px", "7": "48px", "8": "72px", "9": "112px"
    },
    "shape": {
      "tilt": "-9deg",
      "skew": "-12deg",
      "slant": "12px",
      "cut": "28px",
      "border": "2px",
      "hard-shadow": "3px 3px 0",
      "hard-shadow-l": "8px 8px 0"
    },
    "layout": {
      "max": "1180px",
      "measure": "68ch",
      "gutter": "max(16px, calc((100vw - 1180px) / 2))"
    },
    "motion": {
      "instant": "80ms",
      "quick": "180ms",
      "base": "260ms",
      "emph": "480ms",
      "hero": "760ms",
      "stagger": "55ms",
      "ease-snap": "cubic-bezier(.2,.9,.25,1.25)",
      "ease-out": "cubic-bezier(.05,.7,.1,1)",
      "ease-inout": "cubic-bezier(.65,0,.35,1)",
      "repeat-delay": "380ms",
      "repeat-rate": "110ms"
    },
    "z": {
      "water": "0", "scrim": "1", "layer": "2", "fx": "4", "ui": "6", "util": "7", "overlay": "20", "transition": "21", "flying": "22"
    }
  },
  "semantic": {
    "bg": "void",
    "bg-raised": "navy",
    "text": "paper",
    "text-2": "mist",
    "text-3": "muted",
    "light": "cyan",
    "accent": "warm",
    "on-light": "ink",
    "on-paper": "ink",
    "edge": "pink",
    "shadow": "navy",
    "link": "cyan"
  },
  "themes": {
    "atelier": {
      "$description": "Default: the blog and portfolio (Midnight Atelier)."
    },
    "sixk": {
      "$description": "Atelier6K product demo. Keeps its own colder cyan and status colors; shares everything else.",
      "color": {
        "cyan": "#38D6FF",
        "void": "#030B26",
        "navy": "#061541",
        "deep": "#0D2F8F"
      }
    }
  },
  "contrast": {
    "$description": "Pairs every theme must pass (WCAG 2.x ratio). bg may be a core color name.",
    "pairs": [
      { "fg": "paper", "bg": "void", "min": 4.5, "use": "body text" },
      { "fg": "mist", "bg": "void", "min": 4.5, "use": "secondary text" },
      { "fg": "muted", "bg": "void", "min": 4.5, "use": "captions, meta" },
      { "fg": "cyan", "bg": "void", "min": 4.5, "use": "links" },
      { "fg": "paper", "bg": "navy", "min": 4.5, "use": "text on raised plates" },
      { "fg": "mist", "bg": "navy", "min": 4.5, "use": "secondary text on plates" },
      { "fg": "ink", "bg": "paper", "min": 4.5, "use": "text on paper slabs" },
      { "fg": "ink", "bg": "cyan", "min": 4.5, "use": "badges" },
      { "fg": "warm", "bg": "void", "min": 4.5, "use": "accent text" },
      { "fg": "ink", "bg": "good", "min": 4.5, "use": "status badge" },
      { "fg": "ink", "bg": "warn", "min": 4.5, "use": "status badge" },
      { "fg": "ink", "bg": "bad", "min": 4.5, "use": "status badge" },
      { "fg": "paper", "bg": "water-mid", "min": 4.5, "use": "text over mid water" },
      { "fg": "paper", "bg": "water-bright", "min": 3.0, "use": "large text over bright water (small text needs a plate)" },
      { "fg": "navy", "bg": "paper", "min": 3.0, "use": "hard shadow edge visibility on paper" }
    ],
    "menuTints": {
      "$description": "Hero menu item colors, top to bottom; large text over mid water, min 3.0.",
      "bg": "water-mid",
      "min": 3.0,
      "values": ["#FFFFFF", "#8FF4FF", "#6FE0FF", "#9FD8FF", "#B9C2FF", "#A3B4FF"]
    }
  }
}
